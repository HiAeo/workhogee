# WorkHogee AI 获客伙计 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== 服务器配置 =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ===== 数据库配置（PostgreSQL，可选，不填则使用 JSON 文件存储）=====
DATABASE_ENABLED=false
DATABASE_URL=postgresql://user:password@localhost:5432/workhogee
DATABASE_MAX=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=5000

# ===== JWT 认证配置（生产环境必须修改！）=====
JWT_SECRET=change-this-to-a-random-secret-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===== LLM 配置 =====
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ===== 业务配置 =====
BUSINESS_INDUSTRY=AI SaaS / 企业服务 / 智能营销
BUSINESS_PRODUCT=WorkHogee AI 获客伙计
BUSINESS_TARGET_CUSTOMER=中小企业主、销售负责人

# ===== 邮件配置（可选）=====
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ===== 通知配置（可选）=====
WEBHOOK_URL=
